# Environment variables for local development
# Copy this file to .env and fill in your values

PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Local:  postgresql://user:password@localhost:5432/onestyle_db
# Render: automatically set as DATABASE_URL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/onestyle_db

# Session secret — change this to a long random string in production
SESSION_SECRET=change_this_to_a_random_secret_string

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# ── Request journal (production log format) ────────────────────────────────
# Each HTTP request is logged as one tab-separated HTTP_REQUEST_JOURNAL line.
LOG_JOURNAL=true                 # set to "false" to disable the journal
LOG_ENV=development              # appears in the 10th journal column (env name)
LOG_COMPANY_ID=0000              # company id column (e.g. 8267 in the sample)
LOG_THREAD=node-http             # thread-name column
LOG_SYSTEM=APPLICATION           # system/type column
# Optional regex of request paths to skip (default also skips /api/health,
# /api/events and /api/admin/logs). Example: LOG_SKIP=/^\/(api\/events|favicon)/
LOG_SKIP=
